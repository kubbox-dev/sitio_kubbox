Options -MultiViews

RewriteEngine On

# ── Dominio canónico: www.kubbox.com -> kubbox.com ─────────────────────────────
# Evita contenido duplicado (dos URLs distintas para la misma página a ojos
# de un buscador). El canonical de cada página ya apunta a la versión sin www.
RewriteCond %{HTTP_HOST} ^www\.kubbox\.com$ [NC]
RewriteRule ^ https://kubbox.com%{REQUEST_URI} [R=301,L]

# ── Limpieza de URLs heredadas del WordPress hackeado (permalinks ?p=, etc.) ───
# El WordPress viejo fue comprometido con spam de casino/apuestas; Google
# todavía tiene ~25k de esas URLs en "rastreada, sin indexar". Estas nunca
# existieron en el sitio en React — 410 explícito para que Google las suelte
# del índice en vez de quedar atascadas (antes cerraban en 200 con la home,
# que Google no interpreta como "eliminada").
RewriteCond %{QUERY_STRING} ^(p|page_id|attachment_id|cat)=\d+$ [NC]
RewriteRule ^$ - [G,L]

# ── SPA: rutas reales se sirven directo; todo lo demás es basura heredada ─────
# Confirmado en el router (src/router/index.jsx) + prerender (scripts/prerender.mjs):
# TODA ruta real de la app hoy es una carpeta física en dist/. /servicios/:slug
# no tiene datos activos (src/data/servicios.js) y /proyectos/:slug está acoplado
# 1:1 al mismo array que genera el prerender — no hay ninguna ruta que dependa
# de este fallback. Si eso cambia (nueva ruta dinámica sin prerenderizar), hay
# que excluirla aquí explícitamente ANTES del catch-all.
#
# Excepción: archivo de verificación de Google Search Console (google<token>.html),
# por si alguna vez se usa ese método en vez de la meta tag — cae a un 404 normal
# de Apache en lugar de 410, sin tocar la lógica de arriba.
RewriteCond %{REQUEST_URI} !^/google[a-f0-9]+\.html$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [G,L]

# ── Compresión Gzip ───────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# ── Caché de assets estáticos ────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Vite genera hashes en los nombres, se pueden cachear forever
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
  # index.html nunca se cachea (permite rollbacks inmediatos)
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# ── Headers de seguridad ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # index.html: nunca servir una copia vieja sin antes revalidar con el
  # servidor (protege contra rollbacks/deploys viejos). Sin "no-store" para
  # no bloquear el back/forward cache del navegador — el ErrorBoundary de
  # React ya cubre el caso de un chunk desactualizado con un reload automático.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
